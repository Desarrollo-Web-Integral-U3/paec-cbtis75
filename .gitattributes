# Normalizacion de line endings para evitar conflictos entre Windows y Linux.
# Todo texto se almacena en el repo con LF (Unix). En Windows, git hace
# checkout con LF tambien (no CRLF) porque muchas herramientas del stack
# (docker, nginx, bash scripts) esperan LF.

* text=auto eol=lf

# Codigo fuente
*.py     text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf

# Config
Dockerfile   text eol=lf
.env.example text eol=lf
.gitignore   text eol=lf

# Binarios (no tocar)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.woff   binary
*.woff2  binary
