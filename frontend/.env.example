# URL del backend.
#
# - Desarrollo local (docker-compose): http://localhost:8000
# - Producción (Cloudflare Pages -> Railway): la URL pública del servicio
#   backend en Railway, sin slash final. Ejemplo:
#     VITE_API_URL=https://paec-backend-production.up.railway.app
#
# En Cloudflare Pages se configura desde:
#   Project > Settings > Environment variables > Production
# El valor se inyecta en tiempo de build (vite build), NO en runtime.
VITE_API_URL=http://localhost:8000
