ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://paec_user:paec_pass@db:5432/paec_db
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<generate-a-strong-secret-here>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]

# --- Notificaciones ---
# "console" -> imprime a stdout (default para dev).
# "email"   -> manda correos reales vía Resend (requiere las 3 vars de abajo).
# "webhook" -> POST a un webhook (Discord/Slack), usa EMAIL_API_URL como URL.
NOTIFICATION_PROVIDER=console

# Resend (o cualquier servicio SMTP compatible). Obtén la key en https://resend.com
EMAIL_API_KEY=<your-resend-api-key>
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM=PAEC <onboarding@resend.dev>

# Cloudinary — almacenamiento de evidencias (opcional).
# Obtén tus credenciales en https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# Secreto compartido con los jobs programados (GitHub Actions / Render Cron)
# para autenticar endpoints /api/v1/cron/* sin JWT.
CRON_SECRET=<generate-a-strong-secret-here>

# --- Servicio de terceros: IA (Groq) ---
# Consume la API de Groq (compatible con OpenAI) para generar resúmenes
# semanales de dailies. Obtén tu key gratis en https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
